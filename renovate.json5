{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
  ],
  timezone: "Asia/Shanghai",
  semanticCommits: "enabled",
  dependencyDashboard: true,
  packageRules: [
    {
      description: "所有 mise 工具更新合并为一个 PR",
      matchManagers: ["mise"],
      groupName: "mise tools",
    },
    {
      description: "GitHub Actions 依赖更新合并为一个 PR",
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
    },
    {
      description: "Cargo 依赖的非 major 更新合并为一个 PR",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "cargo dependencies (non-major)",
    },
    {
      description: "限制 ureq 维持在 2.x，避免 v3 破坏性升级与 Rust 2024 要求",
      matchPackageNames: ["ureq"],
      allowedVersions: "<3.0.0",
    },
  ],
}
