{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
  ],
  timezone: "Asia/Shanghai",
  semanticCommits: "enabled",
  dependencyDashboard: true,
  packageRules: [
    {
      description: "所有 mise 工具更新合并为一个 PR",
      matchManagers: ["mise"],
      groupName: "mise tools",
    },
    {
      description: "GitHub Actions 依赖更新合并为一个 PR",
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
    },
    {
      description: "Cargo 依赖的非 major 更新合并为一个 PR",
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "cargo dependencies (non-major)",
    },
    {
      description: "ureq 3.5.x 在无 AVX2 的 x86 CPU 上 SIGILL，固定在 3.4.2（#157、#158），排查清楚前不升级；须排在 Cargo 分组规则之后才能覆盖它",
      matchManagers: ["cargo"],
      matchPackageNames: ["ureq"],
      enabled: false,
    },
  ],
}
