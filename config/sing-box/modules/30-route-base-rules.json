{
  "route": {
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "dns",
          "bittorrent"
        ]
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "global",
        "action": "route",
        "outbound": "proxy"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "network": "udp",
        "port": [
          443,
          80
        ],
        "action": "reject"
      },
      {
        "protocol": "bittorrent",
        "action": "route",
        "outbound": "direct"
      },
      {
        "port_range": [
          "6881:6889"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "torrent"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "Download"
        ],
        "action": "route",
        "outbound": "download"
      },
      {
        "rule_set": [
          "Advertising",
          "Hijacking",
          "MyReject",
          "Privacy"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "ChinaMax",
          "Lan",
          "MyDirect",
          "cftunnel",
          "geoip-cn",
          "torrent"
        ],
        "invert": true,
        "action": "resolve",
        "server": "dns-proxy",
        "strategy": "ipv4_only"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "torrent",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/torrent.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "Download",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/Download.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "Advertising",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/Advertising.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "Hijacking",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/Hijacking.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "MyReject",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/MyReject.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "Privacy",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/Privacy.srs",
        "update_interval": "1d"
      }
    ]
  }
}
