{
  "route": {
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "dns",
          "bittorrent"
        ]
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "network": "udp",
        "port": [
          443,
          80
        ],
        "rule_set": [
          "ChinaMax",
          "Lan",
          "cftunnel",
          "geoip-cn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "network": "udp",
        "port": [
          443,
          80
        ],
        "action": "reject",
        "no_drop": true
      }
    ]
  }
}
