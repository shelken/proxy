{
  "route": {
    "rules": [
      {
        "rule_set": [
          "Anthropic"
        ],
        "action": "route",
        "outbound": "anthropic"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "Anthropic",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/Anthropic.srs",
        "update_interval": "1d"
      }
    ]
  },
  "outbounds": [
    {
      "type": "selector",
      "tag": "anthropic",
      "outbounds": [
        "openai",
        "selfhost",
        "(?i)(新加坡|坡|狮城|SG|Singapore|日本|川日|东京|大阪|泉日|埼玉|沪日|深日|JP|Japan)"
      ],
      "default": "openai",
      "interrupt_exist_connections": true
    }
  ]
}
