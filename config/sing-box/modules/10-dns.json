{
  "dns": {
    "strategy": "prefer_ipv4",
    "optimistic": true,
    "servers": [
      {
        "type": "local",
        "tag": "dns-local-system"
      },
      {
        "type": "udp",
        "tag": "dns-direct-cn",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "dns-proxy",
        "server": "1.1.1.1",
        "detour": "dns-auto",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        }
      },
      {
        "type": "fakeip",
        "tag": "dns-fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          ".int.ooooo.space"
        ],
        "query_type": [
          "A"
        ],
        "action": "predefined",
        "answer": [
          "*. IN A 192.168.69.46"
        ]
      },
      {
        "domain_suffix": [
          "int.ooooo.space"
        ],
        "action": "predefined"
      },
      {
        "rule_set": [
          "MyReject-dns"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "Lan-dns"
        ],
        "server": "dns-local-system",
        "disable_optimistic_cache": true
      },
      {
        "domain_suffix": [
          "local",
          "lan",
          "home.arpa"
        ],
        "server": "dns-local-system",
        "disable_optimistic_cache": true
      },
      {
        "clash_mode": "direct",
        "server": "dns-local-system"
      },
      {
        "rule_set": [
          "MyDirect-dns"
        ],
        "server": "dns-local-system"
      },
      {
        "query_type": [
          "PTR"
        ],
        "server": "dns-local-system"
      },
      {
        "rule_set": [
          "ChinaMax-dns",
          "torrent-dns"
        ],
        "server": "dns-direct-cn"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-fakeip"
      }
    ],
    "final": "dns-proxy"
  },
  "route": {
    "rule_set": [
      {
        "type": "remote",
        "tag": "Lan-dns",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/Lan-dns.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "MyDirect-dns",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/MyDirect-dns.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "MyReject-dns",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/MyReject-dns.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "ChinaMax-dns",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/ChinaMax-dns.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "torrent-dns",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/torrent-dns.srs",
        "update_interval": "1d"
      }
    ]
  }
}
