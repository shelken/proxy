{
  "route": {
    "rules": [
      {
        "rule_set": [
          "grok"
        ],
        "action": "route",
        "outbound": "grok"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "grok",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/grok.srs",
        "update_interval": "1d"
      }
    ]
  },
  "outbounds": [
    {
      "type": "selector",
      "tag": "grok",
      "outbounds": [
        "proxy",
        "selfhost",
        ".*"
      ],
      "default": "proxy",
      "interrupt_exist_connections": true
    }
  ]
}
