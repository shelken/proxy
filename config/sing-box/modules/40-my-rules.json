{
  "route": {
    "rules": [
      {
        "rule_set": [
          "MyReject"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "MyDirect"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "MyProxy"
        ],
        "action": "route",
        "outbound": "proxy"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "MyReject",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/MyReject.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "MyDirect",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/MyDirect.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "MyProxy",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/MyProxy.srs",
        "update_interval": "1d"
      }
    ]
  }
}
