{
  "route": {
    "rules": [
      {
        "protocol": "bittorrent",
        "action": "route",
        "outbound": "torrent"
      },
      {
        "rule_set": [
          "torrent"
        ],
        "action": "route",
        "outbound": "torrent"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "torrent",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/shelken/proxy/sing-box-rules/singbox/torrent.srs",
        "update_interval": "1d"
      }
    ]
  },
  "outbounds": [
    {
      "type": "selector",
      "tag": "torrent",
      "outbounds": [
        "direct",
        "selfhost",
        "proxy"
      ],
      "default": "direct",
      "interrupt_exist_connections": true
    }
  ]
}
