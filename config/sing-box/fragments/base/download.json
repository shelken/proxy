{
  "route": {
    "rules": [
      {
        "rule_set": [
          "Download"
        ],
        "action": "route",
        "outbound": "download"
      }
    ]
  },
  "outbounds": [
    {
      "type": "selector",
      "tag": "download",
      "outbounds": [
        "selfhost",
        "proxy",
        "direct",
        ".*"
      ],
      "default": "selfhost",
      "interrupt_exist_connections": true
    }
  ]
}
