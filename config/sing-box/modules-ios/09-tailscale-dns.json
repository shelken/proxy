{
  "dns": {
    "servers": [
      {
        "type": "tailscale",
        "tag": "dns-ts",
        "endpoint": "ts-ep",
        "accept_default_resolvers": false,
        "accept_search_domain": true
      }
    ],
    "rules": [
      {
        "preferred_by": "dns-ts",
        "server": "dns-ts",
        "disable_optimistic_cache": true
      }
    ]
  }
}
