#!name=中国移动签到有礼
#!desc=自动提取中国移动APP「签到有礼」活动的登录凭据并每日自动签到。首次进入中国移动APP活动页后自动保存长效登录凭据，每日 cron 自动续期并签到、通知本月已签天数；登录态失效时通知重新进入 APP。需要 Loon 开启 MITM 并信任证书。
#!author=shelken
#!system=iOS, iPadOS, macOS
#!loon_version=3.2.1(733)
#!homepage=https://github.com/shelken/proxy/blob/main/README.md
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ChinaMobile.png
#!tag=签到

[Argument]
captureEnabled=switch,true,tag=自动提取凭据,desc=关闭后不再捕获自动登录请求
signEnabled=switch,true,tag=每日签到,desc=关闭后不再执行定时签到
signTime=input,"30 0,1 * * *",tag=签到时间,desc=默认 0:30 签到，1:30 自动补试
notify=switch,true,tag=签到结果通知,desc=关闭后不再发送通知

[Script]
http-request ^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/LN\/uamonekeylogin\/autoLogin script-path=https://raw.githubusercontent.com/shelken/proxy/main/config/loon/plugins/cmcc-sign/capture.js, requires-body=true, enable={captureEnabled}, tag=移动签到有礼-提取凭据
cron {signTime} script-path=https://raw.githubusercontent.com/shelken/proxy/main/config/loon/plugins/cmcc-sign/sign.js, argument=[{notify}], enable={signEnabled}, tag=移动签到有礼-每日签到

[MITM]
hostname=wx.10086.cn, client.app.coc.10086.cn
